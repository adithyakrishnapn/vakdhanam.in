rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isModerator() {
      return isSignedIn() && (request.auth.token.admin == true || request.auth.token.moderator == true);
    }

    function onlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && onlyKeys(['id', 'username', 'email', 'avatar', 'createdAt', 'role', 'emailVerified']) && request.resource.data.role in ['visitor', 'user', 'moderator', 'admin'];
      allow update: if isSignedIn() && request.auth.uid == userId && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    match /promises/{promiseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isVerifiedEmail() && onlyKeys(['id', 'promiseId', 'userId', 'content', 'likes', 'createdAt']) && request.resource.data.userId == request.auth.uid && request.resource.data.content is string && request.resource.data.content.size() <= 500;
      allow update: if isModerator();
      allow delete: if isModerator();
    }

    match /polls/{pollId} {
      allow read: if true;
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() && onlyKeys(['id', 'reason', 'reportedBy', 'promiseId', 'createdAt']) && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if isModerator();
    }

    match /submissions/{submissionId} {
      allow read: if isModerator() || (isSignedIn() && resource.data.createdBy == request.auth.uid);
      allow create: if isVerifiedEmail();
      allow update, delete: if isModerator();
    }

    match /reactions/{reactionId} {
      allow read: if isModerator();
      allow write: if false;
    }

    match /votes/{voteId} {
      allow read: if isModerator();
      allow write: if false;
    }

    match /rateLimits/{docId} {
      allow read, write: if false;
    }
  }
}
